# MentorHub AI Service - Environment Variables

# Application
APP_NAME="MentorHub AI Service"
DEBUG=false
VERSION="3.0.0"

# API
API_PREFIX="/api/v3"
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mentorhub"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL=300

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4-turbo-preview"
OPENAI_MAX_TOKENS=2000

# Deepgram
DEEPGRAM_API_KEY=""

# ML Models
SENTENCE_TRANSFORMER_MODEL="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384
FAISS_INDEX_TYPE="Flat"

# Matching Algorithm
MATCHING_TOP_K=50
MATCHING_FINAL_K=10
MATCHING_MIN_SCORE=0.5

# Scoring Weights
WEIGHT_SEMANTIC=0.30
WEIGHT_AVAILABILITY=0.20
WEIGHT_EXPERTISE=0.25
WEIGHT_COMMUNICATION=0.10
WEIGHT_SUCCESS=0.15

# Security
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Monitoring
ENABLE_METRICS=true
ENABLE_TRACING=true
