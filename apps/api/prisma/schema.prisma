enum MatchingStatus {
  ACTIVE
  INACTIVE
  NEEDS_UPDATE
}

enum ChurnRisk {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model MatchingProfile {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String         @unique @map("user_id") @db.Uuid

  // Embeddings (stored as JSON arrays)
  skillsEmbedding   Json?          @map("skills_embedding") @db.JsonB
  goalsEmbedding    Json?          @map("goals_embedding") @db.JsonB

  // Preferences
  preferredStyle    String?        @map("preferred_style") @db.VarChar(50) // structured, flexible, hands-on
  communicationStyle String?       @map("communication_style") @db.VarChar(50)
  availabilityScore Float          @default(0) @map("availability_score") @db.Real

  // ML Scores
  qualityScore      Float          @default(0) @map("quality_score") @db.Real
  engagementScore   Float          @default(0) @map("engagement_score") @db.Real

  status            MatchingStatus @default(ACTIVE)
  lastSyncedAt      DateTime?      @map("last_synced_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user User @relation("MatchingProfile", fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("matching_profiles")
}

model SessionTranscript {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String   @unique @map("booking_id") @db.Uuid

  // Transcription
  fullTranscript  String   @map("full_transcript") @db.Text
  segments        Json     @db.JsonB // timestamped segments with speaker labels

  // AI Analysis
  summary         String?  @db.Text
  keyPoints       String[] @map("key_points")
  actionItems     Json?    @map("action_items") @db.JsonB
  sentiment       String?  @db.VarChar(20) // positive, neutral, negative

  // Knowledge Graph
  topics          String[]
  concepts        String[]

  // Processing
  processingTime  Int?     @map("processing_time") // milliseconds
  confidenceScore Float?   @map("confidence_score") @db.Real

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  booking       Booking          @relation("TranscriptBooking", fields: [bookingId], references: [id], onDelete: Cascade)
  knowledgeNodes KnowledgeNode[]

  @@index([bookingId])
  @@map("session_transcripts")
}

model KnowledgeNode {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transcriptId String   @map("transcript_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid

  // Node Data
  concept      String   @db.VarChar(200)
  description  String?  @db.Text
  importance   Float    @db.Real // 0-1

  // Relations to other concepts
  relatedConcepts Json? @map("related_concepts") @db.JsonB

  // Metadata
  sourceTimestamp Int?  @map("source_timestamp") // seconds into session

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  transcript SessionTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  user       User              @relation("UserKnowledge", fields: [userId], references: [id], onDelete: Cascade)

  @@index([transcriptId])
  @@index([userId])
  @@map("knowledge_nodes")
}

model UserHealthScore {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  date                DateTime  @db.Date

  // Composite Score
  healthScore         Float     @map("health_score") @db.Real // 0-100

  // Component Scores
  engagementScore     Float     @map("engagement_score") @db.Real
  satisfactionScore   Float     @map("satisfaction_score") @db.Real
  progressScore       Float     @map("progress_score") @db.Real
  retentionScore      Float     @map("retention_score") @db.Real

  // Churn Prediction
  churnRisk           ChurnRisk @map("churn_risk")
  churnProbability    Float     @map("churn_probability") @db.Real // 0-1

  // Trends
  scoreChange         Float     @map("score_change") @db.Real // vs previous week
  trendDirection      String    @map("trend_direction") @db.VarChar(20) // up, down, stable

  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user User @relation("UserHealthScores", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([churnRisk])
  @@map("user_health_scores")
}

model ChurnPrediction {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  predictedChurnDate DateTime @map("predicted_churn_date") @db.Date
  probability       Float    @db.Real // 0-1
  riskLevel         ChurnRisk @map("risk_level")

  // Contributing Factors
  primaryFactors    String[] @map("primary_factors")
  recommendations   String[] // suggested retention actions

  // Model Info
  modelVersion      String   @map("model_version") @db.VarChar(50)
  confidence        Float    @db.Real

  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user User @relation("ChurnPredictions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([riskLevel])
  @@map("churn_predictions")
}

