enum RoomStatus {
  SCHEDULED
  ACTIVE
  ENDED
}

enum ParticipantRole {
  HOST
  CO_HOST
  PARTICIPANT
}

model VideoRoom {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String?    @unique @map("booking_id") @db.Uuid

  // Room Info
  roomName        String     @map("room_name") @db.VarChar(200)
  roomId          String     @unique @map("room_id") @db.VarChar(100) // external provider ID
  provider        String     @db.VarChar(50) // agora, twilio, custom

  // Access
  joinUrl         String     @map("join_url") @db.Text
  password        String?    @db.VarChar(50)

  // Settings
  maxParticipants Int        @default(10) @map("max_participants")
  recordingEnabled Boolean   @default(true) @map("recording_enabled")
  transcriptionEnabled Boolean @default(false) @map("transcription_enabled")

  // Status
  status          RoomStatus @default(SCHEDULED)

  // Timing
  scheduledStart  DateTime   @map("scheduled_start") @db.Timestamptz(6)
  actualStart     DateTime?  @map("actual_start") @db.Timestamptz(6)
  actualEnd       DateTime?  @map("actual_end") @db.Timestamptz(6)

  // Stats
  participantCount Int       @default(0) @map("participant_count")
  duration        Int?       // actual duration in seconds

  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  booking      Booking?          @relation("RoomBooking", fields: [bookingId], references: [id], onDelete: SetNull)
  participants VideoParticipant[]
  recordings   VideoRecording[]

  @@index([status])
  @@index([scheduledStart])
  @@map("video_rooms")
}

model VideoParticipant {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId         String          @map("room_id") @db.Uuid
  userId         String?         @map("user_id") @db.Uuid

  // Participant Info
  displayName    String          @map("display_name") @db.VarChar(200)
  role           ParticipantRole @default(PARTICIPANT)

  // Connection
  joinedAt       DateTime        @map("joined_at") @db.Timestamptz(6)
  leftAt         DateTime?       @map("left_at") @db.Timestamptz(6)
  duration       Int             @default(0) // seconds

  // Technical
  connectionQuality String?      @map("connection_quality") @db.VarChar(20) // excellent, good, poor
  deviceType     String?         @map("device_type") @db.VarChar(50)

  // Engagement
  cameraEnabled  Boolean         @default(true) @map("camera_enabled")
  micEnabled     Boolean         @default(true) @map("mic_enabled")
  screenShared   Boolean         @default(false) @map("screen_shared")

  // Relations
  room VideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User?     @relation("VideoParticipants", fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([userId])
  @@map("video_participants")
}

model VideoRecording {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId      String   @map("room_id") @db.Uuid

  // Recording Info
  fileUrl     String   @map("file_url") @db.Text
  thumbnailUrl String? @map("thumbnail_url") @db.Text
  duration    Int      // seconds
  fileSize    BigInt   @map("file_size") // bytes
  format      String   @db.VarChar(20) // mp4, webm

  // Processing
  isProcessed Boolean  @default(false) @map("is_processed")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  // Access
  isPublic    Boolean  @default(false) @map("is_public")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  room VideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("video_recordings")
}

