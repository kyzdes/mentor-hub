// MentorHub v2.0 - Enhanced Database Schema
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  MENTOR
  MENTEE
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  NEW_BOOKING
  REMINDER_1H
  REMINDER_24H
  CANCELLATION
  RESCHEDULE
  NEW_MESSAGE
  NEW_REVIEW
  ACHIEVEMENT_UNLOCKED
  GOAL_COMPLETED
  PAYMENT_RECEIVED
}

enum NotificationChannel {
  EMAIL
  PUSH
  TELEGRAM
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  EXPIRED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  VIDEO
}

enum AchievementType {
  SESSIONS_COMPLETED
  GOALS_ACHIEVED
  REVIEWS_RECEIVED
  STREAK_MAINTAINED
  COMMUNITY_HELPER
  REVENUE_MILESTONE
}

// ============================================================================
// USERS & PROFILES
// ============================================================================

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  firstName     String   @map("first_name") @db.VarChar(100)
  lastName      String?  @map("last_name") @db.VarChar(100)
  role          UserRole @default(MENTEE)

  // Contact Info
  phone         String?  @db.VarChar(20)
  timezone      String   @default("Europe/Moscow") @db.VarChar(50)
  language      String   @default("en") @db.VarChar(10)

  // Profile
  avatarUrl     String?  @map("avatar_url") @db.Text
  bio           String?  @db.Text
  headline      String?  @db.VarChar(255)
  videoIntroUrl String?  @map("video_intro_url") @db.Text

  // Social
  telegramId       BigInt?  @unique @map("telegram_id")
  telegramUsername String?  @map("telegram_username") @db.VarChar(100)
  linkedinUrl      String?  @map("linkedin_url") @db.Text
  twitterHandle    String?  @map("twitter_handle") @db.VarChar(100)
  websiteUrl       String?  @map("website_url") @db.Text

  // Mentor-specific fields
  yearsExperience  Int?     @map("years_experience")
  hourlyRate       Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  responseTime     Int?     @map("response_time") // in hours
  isPublic         Boolean  @default(false) @map("is_public")
  isPremium        Boolean  @default(false) @map("is_premium")

  // Stats
  rating           Decimal? @db.Decimal(3, 2)
  totalReviews     Int      @default(0) @map("total_reviews")
  totalSessions    Int      @default(0) @map("total_sessions")
  totalRevenue     Decimal  @default(0) @map("total_revenue") @db.Decimal(10, 2)

  // Gamification
  points           Int      @default(0)
  level            Int      @default(1)
  currentStreak    Int      @default(0) @map("current_streak")
  longestStreak    Int      @default(0) @map("longest_streak")

  // Payment
  stripeCustomerId String?  @unique @map("stripe_customer_id") @db.VarChar(255)
  stripeAccountId  String?  @unique @map("stripe_account_id") @db.VarChar(255)

  // Settings
  emailVerified    Boolean  @default(false) @map("email_verified")
  isActive         Boolean  @default(true) @map("is_active")
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)

  // Metadata
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  mentorProfile          MentorProfile?
  categories             UserCategory[]
  meetingTypes           MeetingType[]
  availability           MentorAvailability[]
  availabilityExceptions AvailabilityException[]
  bookingsAsMentor       Booking[]               @relation("MentorBookings")
  bookingsAsMentee       Booking[]               @relation("MenteeBookings")
  reviewsWritten         Review[]                @relation("ReviewAuthor")
  reviewsReceived        Review[]                @relation("ReviewRecipient")
  notifications          Notification[]
  auditLogs              AuditLog[]
  paymentsReceived       Payment[]               @relation("PaymentRecipient")
  paymentsMade           Payment[]               @relation("PaymentPayer")
  subscriptions          Subscription[]
  sentMessages           Message[]               @relation("MessageSender")
  conversations          ConversationParticipant[]
  goals                  Goal[]
  achievements           UserAchievement[]
  referralsGiven         Referral[]              @relation("Referrer")
  referralsReceived      Referral[]              @relation("Referred")

  @@index([email])
  @@index([role])
  @@index([isPublic])
  @@index([rating])
  @@map("users")
}

model MentorProfile {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid

  // Professional Info
  title             String   @db.VarChar(200)
  company           String?  @db.VarChar(200)
  industry          String?  @db.VarChar(100)

  // Expertise
  expertise         String[] // Array of expertise areas
  skills            String[] // Array of skills
  languages         String[] // Array of languages

  // Visibility
  featuredUntil     DateTime? @map("featured_until") @db.Timestamptz(6)
  sortOrder         Int       @default(0) @map("sort_order")

  // SEO
  metaTitle         String?   @map("meta_title") @db.VarChar(200)
  metaDescription   String?   @map("meta_description") @db.Text

  // Metadata
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentor_profiles")
}

// ============================================================================
// CATEGORIES
// ============================================================================

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(50)
  parentId    String?  @map("parent_id") @db.Uuid
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  parent       Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]      @relation("CategoryTree")
  userCategories UserCategory[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model UserCategory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
  @@index([categoryId])
  @@map("user_categories")
}

// ============================================================================
// MEETING TYPES & BOOKINGS
// ============================================================================

model MeetingType {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorId         String   @map("mentor_id") @db.Uuid
  name             String   @db.VarChar(200)
  slug             String   @db.VarChar(200)
  description      String?  @db.Text
  duration         Int      // minutes
  price            Decimal  @default(0) @db.Decimal(10, 2)
  currency         String   @default("USD") @db.VarChar(3)
  color            String   @default("#3B82F6") @db.VarChar(7)
  icon             String?  @db.VarChar(50)
  isActive         Boolean  @default(true) @map("is_active")
  requiresApproval Boolean  @default(false) @map("requires_approval")
  monthlyLimit     Int?     @map("monthly_limit")
  formFields       Json     @default("[]") @map("form_fields") @db.JsonB

  // v2.0 additions
  maxParticipants  Int      @default(1) @map("max_participants") // for group sessions
  allowRecording   Boolean  @default(true) @map("allow_recording")

  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  mentor   User      @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([mentorId, slug])
  @@index([mentorId])
  @@index([slug])
  @@index([isActive])
  @@map("meeting_types")
}

model MentorAvailability {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorId    String   @map("mentor_id") @db.Uuid
  dayOfWeek   Int      @map("day_of_week") // 0-6 (Sunday-Saturday)
  startTime   String   @map("start_time") @db.Time(6)
  endTime     String   @map("end_time") @db.Time(6)
  timezone    String   @default("Europe/Moscow") @db.VarChar(50)
  isRecurring Boolean  @default(true) @map("is_recurring")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  mentor User @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@map("mentor_availability")
}

model AvailabilityException {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorId  String   @map("mentor_id") @db.Uuid
  date      DateTime @db.Date
  startTime String?  @map("start_time") @db.Time(6)
  endTime   String?  @map("end_time") @db.Time(6)
  reason    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  mentor User @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId, date])
  @@map("availability_exceptions")
}

model Booking {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingTypeId      String        @map("meeting_type_id") @db.Uuid
  mentorId           String        @map("mentor_id") @db.Uuid
  menteeId           String?       @map("mentee_id") @db.Uuid

  // Mentee info (even if not registered)
  menteeName         String        @map("mentee_name") @db.VarChar(200)
  menteeEmail        String        @map("mentee_email") @db.VarChar(255)
  menteePhone        String?       @map("mentee_phone") @db.VarChar(20)

  // Booking details
  startTime          DateTime      @map("start_time") @db.Timestamptz(6)
  endTime            DateTime      @map("end_time") @db.Timestamptz(6)
  timezone           String        @default("Europe/Moscow") @db.VarChar(50)

  // Status
  status             BookingStatus @default(PENDING)

  // Form responses
  formResponses      Json          @default("{}") @map("form_responses") @db.JsonB

  // Meeting details
  videoUrl           String?       @map("video_url") @db.Text
  location           String?       @db.Text

  // v2.0 additions
  recordingUrl       String?       @map("recording_url") @db.Text
  transcriptUrl      String?       @map("transcript_url") @db.Text
  summaryText        String?       @map("summary_text") @db.Text
  actionItems        Json?         @map("action_items") @db.JsonB

  // Notes
  mentorNotes        String?       @map("mentor_notes") @db.Text
  menteeNotes        String?       @map("mentee_notes") @db.Text
  cancellationReason String?       @map("cancellation_reason") @db.Text

  // Metadata
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  meetingType   MeetingType    @relation(fields: [meetingTypeId], references: [id], onDelete: Restrict)
  mentor        User           @relation("MentorBookings", fields: [mentorId], references: [id], onDelete: Restrict)
  mentee        User?          @relation("MenteeBookings", fields: [menteeId], references: [id], onDelete: SetNull)
  notifications Notification[]
  payment       Payment?
  review        Review?

  @@index([mentorId])
  @@index([menteeId])
  @@index([meetingTypeId])
  @@index([status])
  @@index([startTime])
  @@map("bookings")
}

// ============================================================================
// REVIEWS & RATINGS
// ============================================================================

model Review {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String   @unique @map("booking_id") @db.Uuid
  mentorId         String   @map("mentor_id") @db.Uuid
  menteeId         String   @map("mentee_id") @db.Uuid

  // Ratings (1-5)
  overallRating    Int      @map("overall_rating")
  knowledgeRating  Int      @map("knowledge_rating")
  communicationRating Int   @map("communication_rating")
  helpfulnessRating Int     @map("helpfulness_rating")
  valueRating      Int      @map("value_rating")

  // Review content
  title            String?  @db.VarChar(200)
  comment          String   @db.Text

  // Response
  mentorResponse   String?  @map("mentor_response") @db.Text
  respondedAt      DateTime? @map("responded_at") @db.Timestamptz(6)

  // Metadata
  isVerified       Boolean  @default(true) @map("is_verified")
  isPublic         Boolean  @default(true) @map("is_public")
  helpfulCount     Int      @default(0) @map("helpful_count")

  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mentor  User    @relation("ReviewRecipient", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee  User    @relation("ReviewAuthor", fields: [menteeId], references: [id], onDelete: Cascade)

  @@index([mentorId])
  @@index([menteeId])
  @@index([overallRating])
  @@index([createdAt])
  @@map("reviews")
}

// ============================================================================
// PAYMENTS & SUBSCRIPTIONS
// ============================================================================

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String?       @unique @map("booking_id") @db.Uuid
  subscriptionId    String?       @map("subscription_id") @db.Uuid
  payerId           String        @map("payer_id") @db.Uuid
  recipientId       String        @map("recipient_id") @db.Uuid

  // Payment details
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @db.VarChar(3)
  platformFee       Decimal       @map("platform_fee") @db.Decimal(10, 2)
  mentorEarnings    Decimal       @map("mentor_earnings") @db.Decimal(10, 2)

  // Stripe info
  stripePaymentIntentId String?   @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  stripeChargeId        String?   @unique @map("stripe_charge_id") @db.VarChar(255)

  // Status
  status            PaymentStatus @default(PENDING)

  // Metadata
  description       String?       @db.Text
  refundedAmount    Decimal?      @map("refunded_amount") @db.Decimal(10, 2)
  refundedAt        DateTime?     @map("refunded_at") @db.Timestamptz(6)

  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  booking      Booking?      @relation(fields: [bookingId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  payer        User          @relation("PaymentPayer", fields: [payerId], references: [id])
  recipient    User          @relation("PaymentRecipient", fields: [recipientId], references: [id])

  @@index([payerId])
  @@index([recipientId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model Subscription {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String             @map("user_id") @db.Uuid

  // Plan details
  planName              String             @map("plan_name") @db.VarChar(100)
  amount                Decimal            @db.Decimal(10, 2)
  currency              String             @db.VarChar(3)
  interval              String             @db.VarChar(20) // monthly, quarterly, yearly

  // Stripe info
  stripeSubscriptionId  String             @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripePriceId         String             @map("stripe_price_id") @db.VarChar(255)

  // Status
  status                SubscriptionStatus @default(ACTIVE)

  // Dates
  currentPeriodStart    DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd      DateTime           @map("current_period_end") @db.Timestamptz(6)
  cancelAt              DateTime?          @map("cancel_at") @db.Timestamptz(6)
  canceledAt            DateTime?          @map("canceled_at") @db.Timestamptz(6)

  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// ============================================================================
// MESSAGING
// ============================================================================

model Conversation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lastMessage  String?  @map("last_message") @db.Text
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  lastReadAt     DateTime? @map("last_read_at") @db.Timestamptz(6)
  unreadCount    Int       @default(0) @map("unread_count")
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  type           MessageType @default(TEXT)
  content        String      @db.Text
  attachmentUrl  String?     @map("attachment_url") @db.Text
  metadata       Json?       @db.JsonB
  isEdited       Boolean     @default(false) @map("is_edited")
  isDeleted      Boolean     @default(false) @map("is_deleted")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

// ============================================================================
// GAMIFICATION
// ============================================================================

model Achievement {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        AchievementType
  name        String          @db.VarChar(100)
  description String          @db.Text
  icon        String          @db.VarChar(100)
  points      Int
  requirement Int             // threshold to unlock
  isActive    Boolean         @default(true) @map("is_active")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  userAchievements UserAchievement[]

  @@index([type])
  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id") @db.Uuid
  unlockedAt    DateTime @default(now()) @map("unlocked_at") @db.Timestamptz(6)
  progress      Int      @default(0)

  // Relations
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

// ============================================================================
// GOALS & PROGRESS
// ============================================================================

model Goal {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  title       String     @db.VarChar(200)
  description String?    @db.Text
  category    String?    @db.VarChar(100)
  status      GoalStatus @default(ACTIVE)
  targetDate  DateTime?  @map("target_date") @db.Date
  completedAt DateTime?  @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@index([userId])
  @@index([status])
  @@map("goals")
}

model Milestone {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId      String    @map("goal_id") @db.Uuid
  title       String    @db.VarChar(200)
  description String?   @db.Text
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("milestones")
}

// ============================================================================
// REFERRALS
// ============================================================================

model Referral {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId  String    @map("referrer_id") @db.Uuid
  referredId  String    @map("referred_id") @db.Uuid
  code        String    @unique @db.VarChar(50)
  rewardEarned Decimal  @default(0) @map("reward_earned") @db.Decimal(10, 2)
  isPaid      Boolean   @default(false) @map("is_paid")
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

// ============================================================================
// NOTIFICATIONS & AUDIT
// ============================================================================

model Notification {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  bookingId   String?             @map("booking_id") @db.Uuid
  type        NotificationType
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  title       String?             @db.VarChar(255)
  message     String              @db.Text
  data        Json?               @db.JsonB
  scheduledAt DateTime            @map("scheduled_at") @db.Timestamptz(6)
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz(6)
  readAt      DateTime?           @map("read_at") @db.Timestamptz(6)
  errorMessage String?            @map("error_message") @db.Text
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookingId])
  @@index([scheduledAt])
  @@index([readAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  action     String   @db.VarChar(50)
  oldData    Json?    @map("old_data") @db.JsonB
  newData    Json?    @map("new_data") @db.JsonB
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
