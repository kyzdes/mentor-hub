// ============================================================================
// v3.0 ADDITIONS - MULTI-TENANCY & WHITE-LABELING
// ============================================================================

enum TenantPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Tenant {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String       @db.VarChar(200)
  slug              String       @unique @db.VarChar(100)

  // Plan & Status
  plan              TenantPlan   @default(FREE)
  status            TenantStatus @default(TRIAL)

  // Limits
  maxUsers          Int          @default(10) @map("max_users")
  maxMentors        Int          @default(5) @map("max_mentors")
  maxStorage        Int          @default(1073741824) @map("max_storage") // 1GB in bytes

  // Contact
  ownerEmail        String       @map("owner_email") @db.VarChar(255)
  ownerName         String       @map("owner_name") @db.VarChar(200)
  companySize       String?      @map("company_size") @db.VarChar(50)
  industry          String?      @db.VarChar(100)

  // Billing
  stripeCustomerId  String?      @unique @map("stripe_customer_id") @db.VarChar(255)
  trialEndsAt       DateTime?    @map("trial_ends_at") @db.Timestamptz(6)
  subscriptionEndsAt DateTime?   @map("subscription_ends_at") @db.Timestamptz(6)

  // Metadata
  settings          Json         @default("{}") @db.JsonB
  metadata          Json?        @db.JsonB
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  domains           TenantDomain[]
  branding          TenantBranding?
  analytics         TenantAnalytics[]
  featureFlags      TenantFeatureFlag[]
  integrations      TenantIntegration[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

model TenantDomain {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  domain      String   @unique @db.VarChar(255)
  isPrimary   Boolean  @default(false) @map("is_primary")
  isVerified  Boolean  @default(false) @map("is_verified")
  sslEnabled  Boolean  @default(false) @map("ssl_enabled")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

model TenantBranding {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid

  // Visual Identity
  logoUrl         String?  @map("logo_url") @db.Text
  faviconUrl      String?  @map("favicon_url") @db.Text
  primaryColor    String   @default("#3B82F6") @map("primary_color") @db.VarChar(7)
  secondaryColor  String   @default("#10B981") @map("secondary_color") @db.VarChar(7)
  accentColor     String   @default("#F59E0B") @map("accent_color") @db.VarChar(7)

  // Customization
  customCss       String?  @map("custom_css") @db.Text
  customJs        String?  @map("custom_js") @db.Text
  emailTemplate   String?  @map("email_template") @db.Text

  // SEO
  metaTitle       String?  @map("meta_title") @db.VarChar(200)
  metaDescription String?  @map("meta_description") @db.Text
  metaKeywords    String?  @map("meta_keywords") @db.Text

  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

model TenantAnalytics {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  date              DateTime @db.Date

  // User Metrics
  activeUsers       Int      @default(0) @map("active_users")
  newUsers          Int      @default(0) @map("new_users")
  churnedUsers      Int      @default(0) @map("churned_users")

  // Session Metrics
  totalSessions     Int      @default(0) @map("total_sessions")
  completedSessions Int      @default(0) @map("completed_sessions")
  cancelledSessions Int      @default(0) @map("cancelled_sessions")

  // Revenue
  revenue           Decimal  @default(0) @db.Decimal(10, 2)
  platformFee       Decimal  @default(0) @map("platform_fee") @db.Decimal(10, 2)

  // Engagement
  avgSessionDuration Float   @default(0) @map("avg_session_duration")
  nps               Float?   @db.Real // Net Promoter Score

  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
  @@index([date])
  @@map("tenant_analytics")
}

model TenantFeatureFlag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  feature   String   @db.VarChar(100)
  enabled   Boolean  @default(false)
  config    Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, feature])
  @@index([tenantId])
  @@map("tenant_feature_flags")
}

// ============================================================================
// v3.0 ADDITIONS - COURSE MANAGEMENT SYSTEM
// ============================================================================

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  EXPIRED
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  ASSIGNMENT
  LIVE_SESSION
}

model Course {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mentorId         String        @map("mentor_id") @db.Uuid

  // Basic Info
  title            String        @db.VarChar(200)
  slug             String        @db.VarChar(200)
  description      String        @db.Text
  shortDescription String?       @map("short_description") @db.VarChar(500)

  // Classification
  level            CourseLevel   @default(BEGINNER)
  categoryId       String?       @map("category_id") @db.Uuid
  tags             String[]

  // Media
  thumbnailUrl     String?       @map("thumbnail_url") @db.Text
  previewVideoUrl  String?       @map("preview_video_url") @db.Text

  // Pricing
  price            Decimal       @db.Decimal(10, 2)
  currency         String        @default("USD") @db.VarChar(3)

  // Status & Visibility
  status           CourseStatus  @default(DRAFT)
  isPublic         Boolean       @default(false) @map("is_public")
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz(6)

  // Stats
  enrollmentCount  Int           @default(0) @map("enrollment_count")
  rating           Decimal?      @db.Decimal(3, 2)
  reviewCount      Int           @default(0) @map("review_count")

  // Metadata
  duration         Int?          // Total minutes
  language         String        @default("en") @db.VarChar(10)
  learningOutcomes String[]      @map("learning_outcomes")
  prerequisites    String[]
  certificate      Boolean       @default(false)

  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  mentor      User               @relation("CourseMentor", fields: [mentorId], references: [id], onDelete: Restrict)
  modules     CourseModule[]
  enrollments CourseEnrollment[]
  reviews     CourseReview[]

  @@unique([mentorId, slug])
  @@index([mentorId])
  @@index([status])
  @@index([isPublic])
  @@index([rating])
  @@map("courses")
}

model CourseModule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  title       String   @db.VarChar(200)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId       String     @map("module_id") @db.Uuid

  // Content
  title          String     @db.VarChar(200)
  description    String?    @db.Text
  type           LessonType @default(TEXT)
  content        String?    @db.Text

  // Media
  videoUrl       String?    @map("video_url") @db.Text
  videoProvider  String?    @map("video_provider") @db.VarChar(50) // youtube, vimeo, custom
  duration       Int?       // minutes

  // Resources
  attachments    Json?      @db.JsonB
  externalLinks  Json?      @map("external_links") @db.JsonB

  // Settings
  isFree         Boolean    @default(false) @map("is_free")
  isPublished    Boolean    @default(false) @map("is_published")
  sortOrder      Int        @default(0) @map("sort_order")

  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  module      CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  progress    LessonProgress[]

  @@index([moduleId])
  @@map("lessons")
}

model Assignment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId    String   @map("lesson_id") @db.Uuid
  title       String   @db.VarChar(200)
  description String   @db.Text
  instructions String? @db.Text
  maxScore    Int      @default(100) @map("max_score")
  dueDate     DateTime? @map("due_date") @db.Timestamptz(6)
  isRequired  Boolean  @default(true) @map("is_required")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([lessonId])
  @@map("assignments")
}

model Submission {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String    @map("assignment_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  content      String    @db.Text
  attachments  Json?     @db.JsonB
  score        Int?
  feedback     String?   @db.Text
  submittedAt  DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  gradedAt     DateTime? @map("graded_at") @db.Timestamptz(6)

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation("UserSubmissions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([userId])
  @@map("submissions")
}

model CourseEnrollment {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId        String           @map("course_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  status          EnrollmentStatus @default(ACTIVE)
  progress        Int              @default(0) // percentage 0-100
  completedAt     DateTime?        @map("completed_at") @db.Timestamptz(6)
  certificateUrl  String?          @map("certificate_url") @db.Text
  lastAccessedAt  DateTime?        @map("last_accessed_at") @db.Timestamptz(6)
  expiresAt       DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User             @relation("UserEnrollments", fields: [userId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]

  @@unique([courseId, userId])
  @@index([userId])
  @@index([status])
  @@map("course_enrollments")
}

model LessonProgress {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId String           @map("enrollment_id") @db.Uuid
  lessonId     String           @map("lesson_id") @db.Uuid
  isCompleted  Boolean          @default(false) @map("is_completed")
  progress     Int              @default(0) // percentage 0-100
  timeSpent    Int              @default(0) @map("time_spent") // seconds
  completedAt  DateTime?        @map("completed_at") @db.Timestamptz(6)
  lastViewedAt DateTime?        @map("last_viewed_at") @db.Timestamptz(6)

  // Relations
  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@map("lesson_progress")
}

model CourseReview {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  rating      Int
  title       String?  @db.VarChar(200)
  comment     String   @db.Text
  isPublic    Boolean  @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation("UserCourseReviews", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@map("course_reviews")
}

// ============================================================================
// v3.0 ADDITIONS - COMMUNITIES & FORUMS
// ============================================================================

enum CommunityType {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum MemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum PostType {
  DISCUSSION
  QUESTION
  ANNOUNCEMENT
  POLL
}

enum EventStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

model Community {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String        @db.VarChar(200)
  slug             String        @unique @db.VarChar(200)
  description      String        @db.Text
  shortDescription String?       @map("short_description") @db.VarChar(500)
  type             CommunityType @default(PUBLIC)

  // Visual
  avatarUrl        String?       @map("avatar_url") @db.Text
  coverImageUrl    String?       @map("cover_image_url") @db.Text

  // Stats
  memberCount      Int           @default(0) @map("member_count")
  postCount        Int           @default(0) @map("post_count")

  // Settings
  isActive         Boolean       @default(true) @map("is_active")
  requireApproval  Boolean       @default(false) @map("require_approval")
  allowEvents      Boolean       @default(true) @map("allow_events")

  // Categories & Tags
  categoryId       String?       @map("category_id") @db.Uuid
  tags             String[]

  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  members CommunityMember[]
  posts   ForumPost[]
  events  CommunityEvent[]

  @@index([slug])
  @@index([type])
  @@map("communities")
}

model CommunityMember {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String     @map("community_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  role        MemberRole @default(MEMBER)
  joinedAt    DateTime   @default(now()) @map("joined_at") @db.Timestamptz(6)

  // Relations
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation("CommunityMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  @@map("community_members")
}

model ForumPost {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId  String   @map("community_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  type         PostType @default(DISCUSSION)

  // Content
  title        String   @db.VarChar(300)
  content      String   @db.Text
  attachments  Json?    @db.JsonB

  // Engagement
  viewCount    Int      @default(0) @map("view_count")
  replyCount   Int      @default(0) @map("reply_count")
  likeCount    Int      @default(0) @map("like_count")

  // Settings
  isPinned     Boolean  @default(false) @map("is_pinned")
  isLocked     Boolean  @default(false) @map("is_locked")
  isResolved   Boolean  @default(false) @map("is_resolved")

  // Tags
  tags         String[]

  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  community Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User           @relation("ForumPosts", fields: [authorId], references: [id], onDelete: Cascade)
  replies   ForumReply[]
  reactions PostReaction[]

  @@index([communityId])
  @@index([authorId])
  @@index([createdAt])
  @@map("forum_posts")
}

model ForumReply {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid // for nested replies
  content     String   @db.Text
  attachments Json?    @db.JsonB
  likeCount   Int      @default(0) @map("like_count")
  isAccepted  Boolean  @default(false) @map("is_accepted") // for Q&A posts
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  post      ForumPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User           @relation("ForumReplies", fields: [authorId], references: [id], onDelete: Cascade)
  parent    ForumReply?    @relation("ReplyTree", fields: [parentId], references: [id])
  children  ForumReply[]   @relation("ReplyTree")
  reactions PostReaction[]

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@map("forum_replies")
}

model PostReaction {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  postId    String?     @map("post_id") @db.Uuid
  replyId   String?     @map("reply_id") @db.Uuid
  emoji     String      @db.VarChar(10) // 👍, ❤️, 🎉, etc.
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  user  User        @relation("PostReactions", fields: [userId], references: [id], onDelete: Cascade)
  post  ForumPost?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  reply ForumReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, emoji])
  @@unique([userId, replyId, emoji])
  @@index([postId])
  @@index([replyId])
  @@map("post_reactions")
}

model CommunityEvent {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId    String      @map("community_id") @db.Uuid
